---
import siteConfig from '../../site.config';

interface NavItem {
  label: string;
  href: string;
  children?: NavItem[];
  badge?: string;
}

const currentPath = Astro.url.pathname;

// For static mode, we build navigation at build time from the file system
import { readdirSync, readFileSync, statSync } from 'node:fs';
import { resolve, join } from 'node:path';

const RAW_ROOT = resolve(new URL('../../data-raw', import.meta.url).pathname.replace(/^\/([A-Z]:)/, '$1'));
const WIKI_ROOT = resolve(new URL('../../data-wiki', import.meta.url).pathname.replace(/^\/([A-Z]:)/, '$1'));

const dimensionLabels: Record<string, string> = {
  topology: '拓扑',
  api: 'API',
  'data-model': '数据模型',
  flows: '流程',
  concepts: '概念',
};

const typeLabels: Record<string, string> = {
  entity: '实体',
  concept: '概念',
  synthesis: '综合',
};

// Discover projects
const projects: string[] = [];
try {
  const dirs = readdirSync(RAW_ROOT);
  for (const d of dirs) {
    try {
      if (statSync(resolve(RAW_ROOT, d)).isDirectory()) projects.push(d);
    } catch {}
  }
} catch {}

// Build navigation for each project
const projectNav: Record<string, NavItem[]> = {};

for (const project of projects) {
  const nav: NavItem[] = [];

  // Raw section
  const rawItems: NavItem[] = [];
  try {
    const projectRawDir = resolve(RAW_ROOT, project);
    const dimensions = readdirSync(projectRawDir).filter(d => {
      try { return statSync(resolve(projectRawDir, d)).isDirectory(); } catch { return false; }
    });
    for (const dim of dimensions) {
      const files = readdirSync(resolve(projectRawDir, dim)).filter(f => f.endsWith('.md'));
      rawItems.push({
        label: dimensionLabels[dim] || dim,
        href: `/projects/${project}/raw/${dim}/`,
        badge: String(files.length),
      });
    }
  } catch {}

  if (rawItems.length > 0) {
    nav.push({ label: 'Raw 文档', href: `/projects/${project}/raw/`, children: rawItems });
  }

  // Wiki section
  const wikiItems: NavItem[] = [];
  try {
    const projectWikiDir = resolve(WIKI_ROOT, 'projects', project);
    const types = readdirSync(projectWikiDir).filter(d => {
      try { return statSync(resolve(projectWikiDir, d)).isDirectory(); } catch { return false; }
    });
    for (const type of types) {
      const files = readdirSync(resolve(projectWikiDir, type)).filter(f => f.endsWith('.md'));
      wikiItems.push({
        label: typeLabels[type] || type,
        href: `/projects/${project}/wiki/${type}/`,
        badge: String(files.length),
      });
    }
  } catch {}

  if (wikiItems.length > 0) {
    nav.push({ label: 'Wiki 页面', href: `/projects/${project}/wiki/`, children: wikiItems });
  }

  // Graph link
  nav.push({ label: '知识图谱', href: `/projects/${project}/graph/` });

  projectNav[project] = nav;
}

// Determine current project from URL
const currentProject = currentPath.match(/\/projects\/([^/]+)\//)?.[1] || projects[0] || '';
const currentNav = currentProject ? projectNav[currentProject] || [] : [];
---

<aside class="fixed left-0 top-[var(--nav-height,3.5rem)] z-30 h-[calc(100vh-var(--nav-height,3.5rem))] w-64 overflow-y-auto border-r border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-6">
  {projects.length > 0 && (
    <div class="mb-6">
      <select
        id="sidebar-project-select"
        class="w-full rounded border border-[var(--color-border)] bg-[var(--color-bg-secondary)] px-2 py-1.5 text-sm"
        onchange="window.location.href = `/projects/${this.value}/`"
      >
        {projects.map(p => (
          <option value={p} selected={p === currentProject}>{p}</option>
        ))}
      </select>
    </div>
  )}

  {currentProject && (
    <div class="mb-4">
      <a href={`/projects/${currentProject}/`} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">← 项目首页</a>
    </div>
  )}

  <nav class="space-y-1">
    {currentNav.map(item => (
      <div>
        <a
          href={item.href}
          class:list={[
            'flex items-center justify-between rounded px-3 py-2 text-sm transition',
            currentPath === item.href
              ? 'bg-[var(--color-bg-secondary)] font-medium text-[var(--color-accent)]'
              : 'text-[var(--color-text)] hover:bg-[var(--color-bg-secondary)]',
          ]}
        >
          <span>{item.label}</span>
          {item.badge && <span class="rounded-full bg-[var(--color-bg-secondary)] px-1.5 py-0.5 text-xs">{item.badge}</span>}
        </a>
        {item.children && item.children.length > 0 && (
          <div class="ml-3 mt-1 space-y-0.5 border-l border-[var(--color-border)] pl-3">
            {item.children.map(child => (
              <a
                href={child.href}
                class:list={[
                  'flex items-center justify-between rounded px-2 py-1.5 text-sm transition',
                  currentPath === child.href
                    ? 'bg-[var(--color-bg-secondary)] font-medium text-[var(--color-accent)]'
                    : 'text-[var(--color-text-muted)] hover:bg-[var(--color-bg-secondary)] hover:text-[var(--color-text)]',
                ]}
              >
                <span>{child.label}</span>
                {child.badge && <span class="text-xs text-[var(--color-text-muted)]">{child.badge}</span>}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </nav>

  {projects.length === 0 && (
    <p class="text-sm text-[var(--color-text-muted)]">暂无项目。运行 <code class="rounded bg-[var(--color-bg-secondary)] px-1 py-0.5 text-xs">/kb scan</code> 开始。</p>
  )}
</aside>
