---
interface Dimension {
  name: string;
  label: string;
  count: number;
  status: 'unprocessed' | 'processed' | 'empty';
}

interface Props {
  dimensions: Dimension[];
}

const { dimensions } = Astro.props;
---
<div class="flex flex-wrap gap-2">
  {dimensions.map(d => (
    <a
      href={`#${d.name}`}
      class:list={[
        'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition',
        d.status === 'processed' && 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200',
        d.status === 'unprocessed' && 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200',
        d.status === 'empty' && 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400',
      ]}
    >
      {d.label}
      {d.count > 0 && <span class="opacity-70">({d.count})</span>}
    </a>
  ))}
</div>
