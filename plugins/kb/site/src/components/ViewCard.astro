---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  count?: number;
}

const { title, description, href, icon, count = 0 } = Astro.props;
---
<a href={href} class="group block rounded-lg border border-[var(--color-border)] p-6 transition hover:border-[var(--color-accent)] hover:shadow-md">
  <div class="flex items-center gap-3">
    <span class="text-2xl">{icon}</span>
    <h3 class="text-lg font-semibold group-hover:text-[var(--color-accent)]">{title}</h3>
    {count > 0 && <span class="ml-auto rounded-full bg-[var(--color-bg-secondary)] px-2 py-0.5 text-xs">{count}</span>}
  </div>
  <p class="mt-3 text-sm text-[var(--color-text-muted)]">{description}</p>
</a>
