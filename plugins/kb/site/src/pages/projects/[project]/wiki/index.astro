---
import DocLayout from '../../../layouts/DocLayout.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  const { readdirSync, statSync } = await import('node:fs');
  const { resolve } = await import('node:path');
  const WIKI_ROOT = resolve(new URL('../../../../data-wiki', import.meta.url).pathname.replace(/^\/([A-Z]:)/, '$1'));

  const projects: { params: { project: string } }[] = [];
  try {
    const dirs = readdirSync(WIKI_ROOT).filter(d => {
      try { return statSync(resolve(WIKI_ROOT, d)).isDirectory(); } catch { return false; }
    });
    for (const dir of dirs) {
      projects.push({ params: { project: dir } });
    }
  } catch {}
  return projects;
}

const { project } = Astro.params;
if (!project) return Astro.redirect('/');

const allWiki = await getCollection('wiki');
const projectPages = allWiki.filter(e => e.id.startsWith(`projects/${project}/`));

const byType: Record<string, typeof projectPages> = {};
for (const page of projectPages) {
  const type = page.data.page_type || 'other';
  if (!byType[type]) byType[type] = [];
  byType[type].push(page);
}

const typeLabels: Record<string, string> = {
  entity: '实体',
  concept: '概念',
  synthesis: '综合分析',
  other: '其他',
};

const typeIcons: Record<string, string> = {
  entity: '🔷',
  concept: '💡',
  synthesis: '🔗',
  other: '📄',
};
---
<DocLayout title={`Wiki — ${project}`}>
  <div class="space-y-8">
    <section>
      <div class="flex items-center gap-3">
        <a href={`/projects/${project}/`} class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)]">← 返回项目</a>
      </div>
      <h1 class="mt-4 text-3xl font-bold">Wiki 页面</h1>
      <p class="mt-2 text-[var(--color-text-muted)]">结构化知识页面 — 按类型分组</p>
    </section>

    {Object.entries(byType).length === 0 ? (
      <p class="text-[var(--color-text-muted)]">暂无 wiki 页面。运行 <code class="rounded bg-[var(--color-bg-secondary)] px-1 py-0.5 text-sm">/kb transform</code> 开始转化。</p>
    ) : (
      Object.entries(byType).map(([type, pages]) => (
        <section>
          <h2 class="mb-4 text-xl font-semibold">{typeIcons[type] || '📄'} {typeLabels[type] || type}</h2>
          <div class="space-y-3">
            {pages.map(page => (
              <a href={`/projects/${project}/wiki/${page.id.replace(`projects/${project}/`, '').replace('.md', '')}`} class="block rounded border border-[var(--color-border)] p-4 transition hover:border-[var(--color-accent)]">
                <h3 class="font-medium">{page.data.title || page.id}</h3>
                {page.data.dimension && (
                  <span class="mt-1 inline-block rounded-full bg-[var(--color-bg-secondary)] px-2 py-0.5 text-xs">
                    {page.data.dimension}
                  </span>
                )}
              </a>
            ))}
          </div>
        </section>
      ))
    )}
  </div>
</DocLayout>
