---
import HomeLayout from '../layouts/HomeLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Read projects from data-raw directory
import { readdirSync, statSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const RAW_ROOT = resolve(new URL('../../data-raw', import.meta.url).pathname.replace(/^\/([A-Z]:)/, '$1'));
const WIKI_ROOT = resolve(new URL('../../data-wiki', import.meta.url).pathname.replace(/^\/([A-Z]:)/, '$1'));

interface Project {
  name: string;
  description: string;
  pageCount: number;
  lastUpdated: string;
}

const projects: Project[] = [];

try {
  const dirs = readdirSync(RAW_ROOT).filter(d => {
    try { return statSync(resolve(RAW_ROOT, d)).isDirectory(); } catch { return false; }
  });
  for (const dir of dirs) {
    const indexPath = resolve(RAW_ROOT, dir, '_map.md');
    let description = '';
    let lastUpdated = '';
    try {
      const content = readFileSync(indexPath, 'utf-8');
      const descMatch = content.match(/描述[：:]\s*(.+)/);
      if (descMatch) description = descMatch[1].trim();
    } catch {}
    // Count wiki pages
    let pageCount = 0;
    try {
      const wikiDir = resolve(WIKI_ROOT, 'projects', dir);
      const walkDir = (p: string) => {
        for (const entry of readdirSync(p)) {
          const full = resolve(p, entry);
          if (statSync(full).isDirectory()) walkDir(full);
          else if (entry.endsWith('.md')) pageCount++;
        }
      };
      walkDir(wikiDir);
    } catch {}
    projects.push({ name: dir, description, pageCount, lastUpdated });
  }
} catch {}
---
<HomeLayout title="KB 知识库">
  <section class="mb-12">
    <h1 class="text-4xl font-bold">KB 知识库</h1>
    <p class="mt-4 text-lg text-[var(--color-text-muted)]">
      自动化个人知识库 — 从代码仓库提取、转化、加载和呈现知识
    </p>
  </section>

  <section>
    <h2 class="mb-6 text-2xl font-semibold">项目</h2>
    {projects.length === 0 ? (
      <p class="text-[var(--color-text-muted)]">暂无项目。运行 <code class="rounded bg-[var(--color-bg-secondary)] px-1 py-0.5 text-sm">/kb scan</code> 开始。</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map(p => (
          <ProjectCard name={p.name} description={p.description} pageCount={p.pageCount} lastUpdated={p.lastUpdated} />
        ))}
      </div>
    )}
  </section>
</HomeLayout>
